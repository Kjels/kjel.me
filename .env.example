# Copy to .env.local and fill in. .env.local is gitignored.

# --- Admin (/config, /admin) ---
ADMIN_PASSWORD=

# --- Vercel Blob (board copy + books) ---
# Read/write token from the Vercel dashboard. BLOB_PUBLIC_BASE is the store's
# public URL prefix; reads hit the CDN directly to stay inside the Hobby
# "advanced operations" quota (see lib/blob.ts).
BLOB_READ_WRITE_TOKEN=
BLOB_PUBLIC_BASE=

# --- Spotify now-playing (single-user) ---
# Create an app at https://developer.spotify.com/dashboard, then run
# scripts/spotify-auth.mjs once to mint the refresh token.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Optional: playlist ID to mirror instead of top tracks.
SPOTIFY_PLAYLIST_ID=

# --- Visit notification emails via Resend (optional) ---
RESEND_API_KEY=
NOTIFY_TO=
NOTIFY_FROM=
# Max emails per day; the last one says the cap was hit. Default 20.
NOTIFY_DAILY_CAP=
# IANA timezone for timestamps in the emails. Default America/New_York.
NOTIFY_TZ=

# --- TMDB (optional, scripts/resolve-films.mjs cover lookup) ---
TMDB_API_KEY=

# --- GitHub (optional) ---
# Lets /work read ROADMAP.md and metadata from private repos. Public repos
# work without it. A fine-grained token with read access to contents is enough.
GITHUB_TOKEN=
